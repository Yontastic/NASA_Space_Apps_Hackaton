# TerraAnalog - Environment Variables & API Credentials
# Copy this file to .env to configure your local setup

# Application Settings
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true

# Database Connection (SQLite default, PostgreSQL target)
DATABASE_URL=sqlite:///terraanalog.db
# Target PostgreSQL/PostGIS:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/terraanalog

# Server Configuration
HOST=127.0.0.1
PORT=8000

# File Storage
DATA_STORAGE_PATH=./data

# External Open Data Source Credentials (Optional - Falls back to DEMO / Catalog mode)
PROTECTED_PLANET_API_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Quality & Classification Thresholds
MIN_COVERAGE_THRESHOLD=60.0
HIGH_SIMILARITY_THRESHOLD=85.0
MODERATE_SIMILARITY_THRESHOLD=70.0
PARTIAL_SIMILARITY_THRESHOLD=50.0
